# Public browser-safe Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose in NEXT_PUBLIC_* variables or commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only auth mapping. Use a random secret of at least 32 characters.
# This maps the canonical Vietnamese phone number to an opaque Supabase Auth email.
AUTH_INTERNAL_EMAIL_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional; defaults to auth.cas-hoa.local.
AUTH_INTERNAL_EMAIL_DOMAIN=auth.cas-hoa.local

# Shop handoff destinations; update before production launch.
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/your-shop
NEXT_PUBLIC_ZALO_URL=https://zalo.me/your-shop
