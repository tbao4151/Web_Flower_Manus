# Public browser-safe Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical site origin used for OAuth callback and email redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Never expose in NEXT_PUBLIC_* variables or commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. Use a separate random secret of at least 32 characters for
# Admin/Staff management-session signing and verification.
MANAGEMENT_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Server-only hash key for public order lookup audit records.
ORDER_LOOKUP_HASH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Server-only recovery-session signing secret.
RECOVERY_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Shop handoff destinations; update before production launch.
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/your-shop
NEXT_PUBLIC_ZALO_URL=https://zalo.me/your-shop
